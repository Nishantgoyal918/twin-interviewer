# --- required for real use ---------------------------------------------
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Supabase (Settings → API). DATABASE_URL = transaction pooler string (port 6543).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty locally: scripts/dev.py starts an embedded Postgres with pgvector.
DATABASE_URL=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Ours: generate with  python -c "import secrets;print(secrets.token_urlsafe(32))"
INVITE_TOKEN_SECRET=change-me
DEEPGRAM_WEBHOOK_SECRET=change-me
CRON_SECRET=change-me
APP_BASE_URL=http://localhost:8000

# --- local-dev switches (leave empty in production) ---------------------
# memory = in-process Redis stand-in; upstash = real
CACHE_BACKEND=memory
# inline = run jobs in-process right away; qstash = real queue
QUEUE_MODE=inline
# local = files under .data/storage; supabase = real
STORAGE_BACKEND=local
# 1 = accept X-Dev-Creator header instead of a Supabase login
DEV_AUTH=1
# fake = canned LLM output (no OpenAI calls); openai = real
LLM_BACKEND=fake
